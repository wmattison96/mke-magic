# Browser-safe Supabase project values used by @supabase/ssr.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local one-time importer only. Get the direct PostgreSQL connection URI from
# the Supabase Dashboard. Keep it in the ignored .env.local; never expose it to
# the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_DB_URL=
